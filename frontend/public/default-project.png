<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="projectGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="300" fill="url(#projectGrad)"/>
  
  <!-- Project icon -->
  <rect x="150" y="80" width="100" height="100" rx="10" fill="rgba(255,255,255,0.3)"/>
  <circle cx="200" cy="130" r="30" fill="rgba(255,255,255,0.5)"/>
  
  <!-- Text -->
  <text x="200" y="230" font-size="24" font-weight="bold" fill="white" text-anchor="middle" font-family="Arial">Project</text>
  <text x="200" y="265" font-size="14" fill="rgba(255,255,255,0.8)" text-anchor="middle" font-family="Arial">Coming Soon</text>
</svg>