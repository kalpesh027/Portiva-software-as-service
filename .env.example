# =====================================================================
# Portiva — Environment Variables Template
# Copy to .env and fill in your values:   cp .env.example .env
# NEVER commit .env to git
# =====================================================================

# DB and Redis passwords: you CREATE these yourself, pick anything
DB_PASSWORD=portiva123
REDIS_PASSWORD=redis123

# JWT: keep default for local dev, change for production
JWT_SECRET=cG9ydGl2YS1zdXBlci1zZWNyZXQta2V5LTI1Ni1iaXQtbG9uZy1zdHJpbmctaGVyZQ==

# Gmail: use App Password (NOT real password)
# Get from: Google Account → Security → 2-Step Verification → App passwords
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Razorpay: from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Engine: leave as is if using Docker Compose, change if running separately
AI_ENGINE_URL=http://ai-engine:8000

# Frontend base URL used by backend when generating absolute template image links
# Example production value: https://app.yourdomain.com
FRONTEND_URL=http://localhost:5174
